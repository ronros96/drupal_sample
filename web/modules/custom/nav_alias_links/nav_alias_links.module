<?php

/**
 * @file
 * Uses Pathauto aliases for node links in menus.
 */

use Drupal\Core\Url;

/**
 * Implements hook_preprocess_menu().
 */
function nav_alias_links_preprocess_menu(array &$variables): void {
  // Only process the main navigation.
  if (($variables['menu_name'] ?? '') !== 'main') {
    return;
  }

  if (empty($variables['items'])) {
    return;
  }

  _nav_alias_links_process_items($variables['items']);
}

/**
 * Recursively process menu items.
 */
function _nav_alias_links_process_items(array &$items): void {
  foreach ($items as &$item) {
    if (!empty($item['url']) && $item['url'] instanceof Url) {
      $url = $item['url'];

      // Only process node canonical URLs.
      if ($url->getRouteName() === 'entity.node.canonical') {
        $parameters = $url->getRouteParameters();

        if (!empty($parameters['node'])) {
          $nid = (int) $parameters['node'];

          $alias_manager = \Drupal::service('path_alias.manager');

          $alias = $alias_manager->getAliasByPath(
            '/node/' . $nid
          );

          // Only replace the URL when an alias exists.
          if ($alias !== '/node/' . $nid) {
            $item['url'] = Url::fromUserInput($alias);
          }
        }
      }
    }

    // Process child menu items.
    if (!empty($item['below'])) {
      _nav_alias_links_process_items($item['below']);
    }
  }
}